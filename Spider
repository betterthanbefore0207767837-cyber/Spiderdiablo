local SoundService = game:GetService("SoundService")

local HIT_SOUND_ID = "rbxassetid://80064459083952"
local HIT_VOLUME = 0.2

local watched = {}

local function playHitSound()
	local sound = Instance.new("Sound")
	sound.Name = "HitSound"
	sound.SoundId = HIT_SOUND_ID
	sound.Volume = HIT_VOLUME
	sound.Parent = SoundService

	sound:Play()

	sound.Ended:Once(function()
		sound:Destroy()
	end)
end

local function watchCharacter(character)
	if watched[character] then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return
	end

	watched[character] = true

	local lastHealth = humanoid.Health

	humanoid.HealthChanged:Connect(function(newHealth)
		if newHealth < lastHealth and newHealth > 0 then
			playHitSound()
		end

		lastHealth = newHealth
	end)
end

